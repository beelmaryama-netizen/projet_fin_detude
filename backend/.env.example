PORT=3000
DATABASE_URL="mysql://root:@localhost:3306/magicpro"

JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES=15m
REQUIRE_EMAIL_VERIFICATION=true

# Courriels locaux pour developpement ; utiliser smtp en production
MAIL_TRANSPORT=local
MAIL_OUTBOX_DIR=tmp/mail-outbox
MAIL_FROM=MagicPro <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Audiences autorisees, separees par des virgules
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

REMINDERS_ENABLED=true
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
REFRESH_TOKEN_DAYS=7

ADMIN_EMAIL=admin@magicpro.ca
ADMIN_PASSWORD=change_me

FILE_STORAGE=local
PUBLIC_API_URL=http://localhost:3000/api

# Photos (cloudinary.com > Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push (optionnel) : chemin vers le JSON du compte de service Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=
